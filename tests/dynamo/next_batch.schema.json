{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GMcDowellJr/Revit_SSM_Exporter/tests/dynamo/next_batch.schema.json",
  "title": "Revit Stage A next batch",
  "type": "object",
  "required": ["schema_version", "campaign_id", "batch_id", "created_at", "document", "execution_policy", "jobs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "document": {
      "type": "object", "required": ["expected_title"],
      "properties": {"expected_title": {"type": "string"}, "expected_revit_version": {"type": "string"}, "expected_path": {"type": "string"}},
      "additionalProperties": false
    },
    "execution_policy": {
      "type": "object", "required": ["max_jobs_per_run", "on_job_error", "resume"],
      "properties": {"max_jobs_per_run": {"type": "integer", "minimum": 1}, "on_job_error": {"enum": ["stop", "continue"]}, "resume": {"type": "boolean"}, "allow_rerun": {"type": "boolean", "default": false}},
      "additionalProperties": false
    },
    "jobs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/job"}}
  },
  "$defs": {
    "view": {"type": "object", "anyOf": [{"required": ["unique_id"]}, {"required": ["name"]}], "properties": {"unique_id": {"type": "string"}, "name": {"type": "string"}, "view_type": {"type": "string"}, "crop_active": {"type": "boolean"}, "is_template": {"type": "boolean"}}, "additionalProperties": false},
    "job": {"type": "object", "required": ["job_id", "probe_id", "view", "settings", "output_directory"], "properties": {"job_id": {"type": "string"}, "probe_id": {"type": "string"}, "view": {"$ref": "#/$defs/view"}, "settings": {"type": "object"}, "output_directory": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
